# ==============================================================================
# ROBÔ LED PARTNER — DIGITAL MARKETING & CRM PLATFORM
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
NGINX_PORT=8088
APP_URL=https://marketing.roboledpartner.com.br
CORS_ORIGIN=https://marketing.roboledpartner.com.br
COOKIE_DOMAIN=roboledpartner.com.br

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=roboled_user
POSTGRES_PASSWORD=generate_a_strong_password_here_123456
POSTGRES_DB=roboled_marketing_db
POSTGRES_PORT=5432
# When running with Docker Compose:
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"
# When running locally:
# DATABASE_URL="postgresql://roboled_user:password@localhost:5432/roboled_marketing_db?schema=public"

# ------------------------------------------------------------------------------
# 3. ASYNC QUEUE & CACHE (Redis / BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_a_strong_redis_password_here
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (Argon2id + Session Cookies)
# ------------------------------------------------------------------------------
# Generate a 64+ char random hex string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=e7b41d8e1234567890abcdef1234567890abcdef1234567890abcdef12345678
COOKIE_NAME=roboled_session_token
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ------------------------------------------------------------------------------
# 5. META MARKETING API (Graph API v21.0 & Lead Ads)
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Long-Lived System User Access Token with ads_read, ads_management, leads_retrieval
META_ACCESS_TOKEN=
# Format: act_123456789012345
META_AD_ACCOUNT_ID=
# Instagram Business Account ID
META_INSTAGRAM_ACCOUNT_ID=
# Webhook verification token set in Meta App Dashboard
META_VERIFY_TOKEN=roboled_meta_webhook_verify_secret_token

# ------------------------------------------------------------------------------
# 6. WHATSAPP CLOUD API (Official Meta)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=roboled_whatsapp_webhook_verify_token

# ------------------------------------------------------------------------------
# 7. ARTIFICIAL INTELLIGENCE PROVIDERS
# ------------------------------------------------------------------------------
# Set at least one provider key for AI Copywriting, Insights & Briefings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY WORKFLOWS & ECOSYSTEM INTEGRATIONS
# ------------------------------------------------------------------------------
# n8n Automation Engine Webhook URL & HMAC Secret
N8N_WEBHOOK_URL=https://n8n.roboledpartner.com.br/webhook/lead-event
N8N_WEBHOOK_SECRET=roboled_n8n_hmac_secret_key_12345

# Robô LED Partner Ecosystem (Quote & Contract Systems)
QUOTE_SYSTEM_WEBHOOK_URL=https://cotacao.roboledpartner.com.br/api/webhooks/marketing
QUOTE_SYSTEM_API_KEY=

# ------------------------------------------------------------------------------
# 9. FILE STORAGE & UPLOADS (Media Library)
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------------------
# 10. CLOUDFLARE TUNNEL (Zero Trust Self-Hosted Exposure)
# ------------------------------------------------------------------------------
# Token obtained in Cloudflare Zero Trust Dashboard -> Access -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
